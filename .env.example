APP_NAME=VolyLegume
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Indian/Antananarivo

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_MG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Hachage des mots de passe : argon2id (memory-hard, recommande OWASP).
# Les hachages bcrypt existants restent valides et sont rehashees
# automatiquement a la premiere connexion reussie.
# HASH_VERIFY=false : les hachages bcrypt existants restent verifiables et
# sont rehashees en argon2id a la premiere connexion reussie.
HASH_DRIVER=argon2id
HASH_VERIFY=false
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=volylegume
DB_USERNAME=volylegume
DB_PASSWORD=volylegume_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Photographies agricoles : « public » en local, « s3 » en production.
# Pour S3, renseignez aussi AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_DEFAULT_REGION, AWS_BUCKET et éventuellement AWS_URL / AWS_ENDPOINT.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supervision (/health et php artisan system:health)
HEALTH_TOKEN=
HEALTH_BACKUP_MAX_AGE_HOURS=48
HEALTH_QUEUE_BACKLOG_WARNING=1000
HEALTH_FAILED_JOBS_WARNING=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
